# Роль ops_service через пулер Supabase в режиме session (порт 5432).
OPS_DATABASE_URL=postgresql+psycopg://ops_service.<ref>:<password>@aws-0-us-east-2.pooler.supabase.com:5432/postgres
# Ежедневная сводка; пусто — сводка только пишется в журнал задачи.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Ключ для постановки задач через HTTP (заголовок X-Ops-Key).
OPS_API_KEY=
EXPORT_DIR=exports
CELERY_BROKER_URL=amqp://<user>:<pass>@rabbitmq:5672//
