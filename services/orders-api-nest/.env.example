PORT=3100
DATABASE_URL=postgres://orders:orders@localhost:5436/orders
# Токен админки: GET/PATCH /orders. Сгенерировать: openssl rand -hex 32
ADMIN_API_TOKEN=change-me-to-a-long-random-string
