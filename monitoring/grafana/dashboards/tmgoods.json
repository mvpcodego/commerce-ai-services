   "title": "Память и процессор сервера",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 20,
    "w": 24,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes",
     "legendFormat": "память занята",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    },
    {
     "refId": "B",
     "expr": "1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m]))",
